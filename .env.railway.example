APP_NAME="Reserva Escolar API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.reservaescolar.app.br
APP_TIMEZONE=America/Araguaina

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=troque-esta-senha
DB_SSLMODE=require

# Opcional, mas mantido para compatibilidade com a API antiga.
RESERVA_DB_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
RESERVA_DB_DRIVER=pgsql
RESERVA_DB_HOST=aws-0-REGION.pooler.supabase.com
RESERVA_DB_PORT=5432
RESERVA_DB_NAME=postgres
RESERVA_DB_USERNAME=postgres.PROJECT_REF
RESERVA_DB_PASSWORD=troque-esta-senha
RESERVA_DB_CHARSET=utf8
RESERVA_DB_SSLMODE=require

RESERVA_APP_TIMEZONE=America/Araguaina
# Producao:
RESERVA_ALLOWED_ORIGINS=https://app.reservaescolar.com.br,https://painel.reservaescolar.com.br
# Homologacao:
# RESERVA_ALLOWED_ORIGINS=https://app-hml.reservaescolar.com.br,https://painel-hml.reservaescolar.com.br
# Transicao temporaria, se ainda existir frontend no dominio legado:
# RESERVA_ALLOWED_ORIGINS=https://app.reservaescolar.com.br,https://painel.reservaescolar.com.br,https://reservaescolar.app.br,https://www.reservaescolar.app.br
RESERVA_DIAGNOSTIC_TOKEN=troque-por-um-token-longo-e-seguro
RESERVA_CRON_TOKEN=troque-por-um-token-longo-e-seguro

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
